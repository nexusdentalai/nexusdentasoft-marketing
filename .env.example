# Set to "true" to reopen public signups (CTAs link to app register page).
# Leave false (default) to keep Private Beta mode with waitlist modal.
NEXT_PUBLIC_SIGNUPS_OPEN=false

# Target app host for the cross-origin waitlist POST.
NEXT_PUBLIC_APP_URL=https://app.nexusdentasoft.com

# Contact form — Resend (https://resend.com). Required for /api/contact route.
# RESEND_API_KEY : create on Resend dashboard, paste in .env.local (never committed).
# CONTACT_FROM_EMAIL : must be on a domain verified in your Resend account
#   (fallback: onboarding@resend.dev = DEV-only, restricted).
# CONTACT_TO_EMAIL : inbox that receives lead notifications.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=contact@nexusdentasoft.com
CONTACT_TO_EMAIL=contact@nexusdentasoft.com
